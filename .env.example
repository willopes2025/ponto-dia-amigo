# Projeto Supabase da VISIO.
# Copie para .env e preencha com as credenciais do SEU projeto.
# .env está no .gitignore — nunca comite credenciais.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-key"

# Provedores de integração: `mock` roda tudo localmente, sem chamada externa.
VITE_FISCAL_PROVIDER="mock"
VITE_BOLETO_PROVIDER="mock"
VITE_ADQUIRENTE_PROVIDER="mock"
VITE_MENSAGERIA_PROVIDER="mock"
